{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daanvia-logs",
  "main": "src/index.js",
  "account_id": "746d8b6bea980c0ca76e7ce67595b657",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "daanvia_logs", "database_name": "daanvia-logs", "database_id": "18b18a03-f4af-46da-97f8-e3f042d29e01" }
  ],
  // Daily: delete uploads older than 30 days.
  "triggers": { "crons": ["17 3 * * *"] }
  // Reading logs needs a secret: `wrangler secret put ADMIN_TOKEN` (kept in ~/.daanvia/logs-admin-token).
}
