<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only grants, one file at a time: the support report shared from Support, and a downloaded update opened in the
     phone's own installer (AppUpdate). Nothing else can be handed out. -->
<paths>
    <cache-path name="reports" path="reports/" />
    <files-path name="updates" path="updates/" />
</paths>
