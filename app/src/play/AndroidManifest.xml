<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build. Play updates the app, and its policy doesn't allow an app to install its own updates or other
     apps (REQUEST_INSTALL_PACKAGES), so the self-updater's permissions go. The direct "ignore battery optimizations"
     request is restricted on Play too: this build opens the battery settings screen instead (KeepAlive.ask). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
</manifest>
